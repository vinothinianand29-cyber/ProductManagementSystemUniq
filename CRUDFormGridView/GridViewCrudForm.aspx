<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="GridViewCrudForm.aspx.cs" Inherits="CRUDFormGridView.GridViewCrudForm" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>EmployeeDetailsForm</title>
    <link rel="stylesheet" href="Content/EmployeeStyle.css"/>
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <table style="width: 100%;">
                <tr>
                    <td>
                        <asp:Label ID="Label1" runat="server" Text="EmployeeId"></asp:Label></td>
                    <td>
                        <asp:TextBox ID="EmpId" runat="server"></asp:TextBox></td>
                </tr>
                <tr>
                    <td>
                        <asp:Label ID="Label2" runat="server" Text="EmployeeName"></asp:Label></td>
                    <td>
                        <asp:TextBox ID="EmpName" runat="server"></asp:TextBox></td>                   
                </tr>
                <tr>
                    <td><asp:Label ID="Label3" runat="server" Text="EmployeeSalary"></asp:Label></td>
                    <td><asp:TextBox ID="EmpSalary" runat="server"></asp:TextBox></td>   
                </tr>

                <tr>
                   <td><asp:Label ID="Label4" runat="server" Text="EmployeeCity"></asp:Label></td>
                   <td><asp:TextBox ID="EmpCity" runat="server"></asp:TextBox></td>   
</tr>

                <tr>
                   <td><asp:Button ID="Button1" runat="server" Text="Submit" OnClick="Button1_Click"/></td>
                </tr>
            </table>
        </div>
        <div>
            <asp:GridView ID="EmployeeData" runat="server"  DataKeyNames="EmployeeId" AutoGenerateColumns="false" 
                AutoGenerateEditButton="true"
                AutoGenerateDeleteButton="true" OnRowEditing="GridView1_RowEditing"
                OnRowUpdating="GridView1_RowUpdating" 
                OnRowDeleting="GridView1_RowDeleting" 
                OnRowCancelingEdit="GridView1_RowCancelingEdit">

                <Columns>
                    <asp:BoundField DataField="EmployeeId" HeaderText="EmployeeId" ReadOnly="true"/>
                    
                    <asp:TemplateField HeaderText="Name">
                   
                    <ItemTemplate>
                        <%# Eval("EmployeeName") %>
                     </ItemTemplate>

                    <EditItemTemplate>
                        <asp:TextBox ID="txtEmployeeName" runat="server" Text='<%# Bind("EmployeeName") %>'></asp:TextBox>
                    </EditItemTemplate>    

                    </asp:TemplateField>

                    <asp:TemplateField HeaderText="EmployeeSalary">
                   
                   <ItemTemplate>
                   <%# Eval("EmployeeSalary") %>
                   </ItemTemplate>

                   <EditItemTemplate>
                   <asp:TextBox ID="txtEmployeeSalary" runat="server" Text='<%# Bind("EmployeeSalary") %>'></asp:TextBox>
                   </EditItemTemplate>    

                   </asp:TemplateField>

                    <asp:TemplateField HeaderText="EmployeeCity">

                     <ItemTemplate>
                      <%# Eval("EmployeeCity") %>
                     </ItemTemplate>

                     <EditItemTemplate>
                     <asp:TextBox ID="txtEmployeeCity" runat="server" Text='<%# Bind("EmployeeCity") %>'></asp:TextBox>
                     </EditItemTemplate>    

                     </asp:TemplateField>



                </Columns>

            </asp:GridView>


        </div>
    </form>
</body>
</html>
